{
  "name": "MegaPlay Hub",
  "short_name": "MegaPlay",
  "description": "30 polished mini games with progression, achievements and daily challenges — playable offline in your browser.",
  "id": "megaplay-hub",
  "start_url": "./index.html#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0d18",
  "theme_color": "#0a0d18",
  "categories": ["games", "entertainment"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    { "src": "assets/icons/favicon-32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Games Library", "short_name": "Library", "url": "./index.html#/library", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Achievements", "short_name": "Trophies", "url": "./index.html#/achievements", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Statistics", "short_name": "Stats", "url": "./index.html#/statistics", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
