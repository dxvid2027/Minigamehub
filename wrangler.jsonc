{
  // Cloudflare Workers deployment (Workers Static Assets).
  // MegaPlay Hub is a fully static, dependency-free SPA, so it deploys as an
  // assets-only Worker — no server-side script required.
  //
  //   npm run build     → copies the site into ./dist
  //   npm run dev       → local preview on the Workers runtime
  //   npm run deploy    → build + deploy to <name>.<subdomain>.workers.dev
  //
  // ./dist is generated by scripts/build.mjs and contains ONLY the site
  // files, so repo internals (.git, node_modules, configs) are never uploaded.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "megaplay-hub",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    // Hash-based routing means every deep link resolves through index.html.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
